# Supabase project settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Fixed admin login (no self-registration).
# Generate with: npm run admin:hash-password -- "your-password"
# (output is the bcrypt hash, base64-encoded — this project's env loader
# mangles the literal "$" characters in a raw bcrypt hash otherwise)
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Session cookie signing secret. Generate with: openssl rand -base64 32
SESSION_SECRET=
